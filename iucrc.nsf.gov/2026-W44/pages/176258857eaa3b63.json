l":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encoding declared","pass":true,"detail":""},{"id":"lang","label":"Document language (lang) set","pass":true,"detail":"en"},{"id":"viewport","label":"Responsive viewport (zoom not disabled)","pass":true,"detail":"width=device-width, initial-scale=1.0"},{"id":"open-graph","label":"Open Graph tags (5/6)","pass":true,"detail":""},{"id":"twitter-card","label":"Twitter card metadata","pass":true,"detail":""},{"id":"open-social","label":"Open social presence (Mastodon/Bluesky) linked","pass":false,"detail":""}],"passed":8,"total":11,"social":[],"og":{"title":"Center for Atomically Thin Multifunctional Coatings (ATOMIC)","description":"The Center for Atomically Thin Multifunctional Coatings (ATOMIC) focuses on the design and development of cutting-edge coatings based on two-dimensional layered materials. ATOMIC brings together researchers, students, faculty, industry, and national labs to advance the understanding and application of these materials.Two-dimensional (2D) materials, such as graphene, hexagonal boron nitride (h-BN), and transition metal dichalcogenides, possess tunable mechanical, electronic, and optical properties. These properties can be tailored to address critical scientific and technological challenges while enabling multifunctionality.ATOMIC's work targets a range of applications, including corrosion, oxidation, abrasion, friction, wear reduction, and energy storage and harvesting, as well as the scalable synthesis and deposition of novel multifunctional coatings.","url":"/centers/atomically-thin-multifunctional-coatings/","image":"/assets/images/twittercard.png","siteName":null,"type":"article"},"resilience":{"checks":[{"id":"pwa-https","label":"HTTPS (required for service workers)","status":"pass","evidence":"","ex