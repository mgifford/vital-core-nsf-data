ucrc-logo.svg","alt":"NSF & IUCRC Logos","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":225,"renderedHeight":109,"naturalWidth":300,"naturalHeight":145,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":33190},{"src":"https://iucrc.nsf.gov/visuals/css-assets/nsf-iucrc-logo.svg","alt":"NSF & IUCRC Logos","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":300,"renderedHeight":145,"naturalWidth":300,"naturalHeight":145,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":33190},{"src":"https://iucrc.nsf.gov/visuals/css-assets/nsf-iucrc-logo.svg","alt":"NSF & IUCRC Logos","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":165,"renderedHeight":80,"naturalWidth":300,"naturalHeight":145,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":33190}]},"standards":{"engine":"standards","checks":[{"id":"schema-gov","label":"schema.org GovernmentOrganization markup","pass":false,"detail":""},{"id":"canonical","label":"Canonical URL declared","pass":true,"detail":""},{"id":"hreflang","label":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encoding declared","pass":true,"detail":""},{"id":"lang","label":"Document language (lang) set","pass":true,"detail":"en"},{"id":"viewport","label":"Responsive viewport (zoom not disabled)","pass":true,"detail":"width=device-width, initial-scale=1.0"},{"id":"open-graph","label":"Open Graph tags (5/6)","pass":true,"detail":""},{"id":"twitter-card","label":"Twitter card metadata","pass":true,"detail":""},{"id":"open-social","label":"Open social presence (Mastodon/Bluesky) linked","pass":false,"detail":""}],"passed":8,"total":11,"social":[],"og":{"title":"Center on Pervasive Personalized Intelligence (PPI)","description":"The Internet of Things (IoT) marks the dawn of a technological revolution that rivals the industrial revolution. In this new era, intelligent computing becomes anticipatory, proactive, and adaptive. The next big growth in IoT systems will come from pushing Pervasive Personalized Intelligence (PPI) to the edge of the network, where latency is critical, and mobility, privacy, and context awareness are essential qualities of the application.The goal of the Center for Pervasive Personalized Intelligence (PPI) is to enable the next generation of IoT systems to be more proactive and personalized without compromising security and privacy, thereby improving decision-making, increasing efficiency and enabling new types of computing applications. The PPI Center will support the thrusts that enable an entirely new class of applications with intelligence that is predictive instead of reactive, thus making processes more efficient and saving time, energy, and money.Operationalizing compute-intensive AI applications to run on the edge, where compute resources are constrained, is a fundamental technical challenge. Moreover, their complexity will also pose new challenges for security, governance, programmability, and usability. The multi-university, multi-industry PPI Center can address these formidable challenges with a broader solution strategy. The PPI Center works alongside industry members: (i) as a research and development partner to help them build a platform on which they can build smart applications for various verticals, and (ii) as a center of excellence to create and disseminate a systematic body of knowledge required for building PPI applications. ","url":"/centers/center-on-pervasive-personalized-intelligence-ppi/","image":"/assets/images/twittercard.png","siteName":null,"type":"articl