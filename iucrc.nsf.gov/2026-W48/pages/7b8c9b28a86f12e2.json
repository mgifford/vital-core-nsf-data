abel":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encoding declared","pass":true,"detail":""},{"id":"lang","label":"Document language (lang) set","pass":true,"detail":"en"},{"id":"viewport","label":"Responsive viewport (zoom not disabled)","pass":true,"detail":"width=device-width, initial-scale=1.0"},{"id":"open-graph","label":"Open Graph tags (5/6)","pass":true,"detail":""},{"id":"twitter-card","label":"Twitter card metadata","pass":true,"detail":""},{"id":"open-social","label":"Open social presence (Mastodon/Bluesky) linked","pass":false,"detail":""}],"passed":8,"total":11,"social":[],"og":{"title":"Catalyzing Commercialization: Creating Novel Bimetallic Catalysts for Methanol Fuel Cells","description":"Improvements in direct-methanol fuel cells (DMFCs) have been achieved at the Univ. of South Carolina based on a new, easy-to-scale method to synthesize bimetallic catalysts. The two most common types of fuel cells being developed for mobile transportation applications are DMFCs and hydrogen fuel cells. Methanol is safer than hydrogen, and it is easier to handle and install in refueling stations. Whereas a monometallic platinum (Pt) catalyst may be used for H2 fuel cells, a more-expensive bimetallic catalyst — typically consisting of Pt and ruthenium (Ru) — is required for DMFCs.","url":"/centers/achievements/creating-novel-bimetallic-catalysts/","image":"/assets/images/twittercard.png","siteName":null,"type":"article"},"resilience":{"checks":[{"id":"pwa-https","label":"HTTPS (required for service workers)","status":"pass","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/achievements/creating-novel-bimetallic-catalysts/","why":"HTTPS is required for service workers and most install prompts."},{"id":"pwa-manifest","label":"Web app manifest declared","status":"fail",