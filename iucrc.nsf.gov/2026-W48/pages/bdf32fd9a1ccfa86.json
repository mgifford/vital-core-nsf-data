false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":64,"renderedHeight":64,"naturalWidth":64,"naturalHeight":64,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":402},{"src":"https://iucrc.nsf.gov/visuals/css-assets/nsf-iucrc-logo.svg","alt":"NSF & IUCRC Logos","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":225,"renderedHeight":109,"naturalWidth":300,"naturalHeight":145,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":33190},{"src":"https://iucrc.nsf.gov/visuals/css-assets/nsf-iucrc-logo.svg","alt":"NSF & IUCRC Logos","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":300,"renderedHeight":145,"naturalWidth":300,"naturalHeight":145,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":33190},{"src":"https://iucrc.nsf.gov/visuals/css-assets/nsf-iucrc-logo.svg","alt":"NSF & IUCRC Logos","hasAlt":true,"isDecorative":false,"isMissingAlt":false,"ariaHidden":false,"rolePresentation":false,"renderedWidth":165,"renderedHeight":80,"naturalWidth":300,"naturalHeight":145,"loading":null,"decoding":null,"altVerdict":"GOOD","altReason":"present, no red flags","bytes":33190}]},"standards":{"engine":"standards","checks":[{"id":"schema-gov","label":"schema.org GovernmentOrganization markup","pass":false,"detail":""},{"id":"canonical","label":"Canonical URL declared","pass":true,"detail":""},{"id":"hreflang","label":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encoding declared","pass":true,"detail":""},{"id":"lang","label":"Document language (lang) set","pass":true,"detail":"en"},{"id":"viewport","label":"Responsive viewport (zoom not disabled)","pass":true,"detail":"width=device-width, initial-scale=1.0"},{"id":"open-graph","label":"Open Graph tags (5/6)","pass":true,"detail":""},{"id":"twitter-card","label":"Twitter card metadata","pass":true,"detail":""},{"id":"open-social","label":"Open social presence (Mastodon/Bluesky) linked","pass":false,"detail":""}],"passed":8,"total":11,"social":[],"og":{"title":"Center for Disruptive Musculoskeletal Innovations (CDMI)","description":"The Center for Disruptive Musculoskeletal Innovations (CDMI) represents a novel integration of health care economics, biomedical science, and clinical medicine, researching technologies that will decrease health care costs and improve the management and life of patients with musculoskeletal disease.CDMI targets the growing burden of musculoskeletal disorders (MSDs) by being a primary source for fundamental research on clinical outcomes and cost, implant materials, tissue engineering, biosensors, implant testing protocols, noninvasive diagnostic and preventive technologies, and novel imaging. Preventing and treating MSDs are of key importance.Prevention is a priority for U.S. business, as MSDs account for about 37% of all injury cases. The average direct cost of a work-related MSD is more than $32,000. Low-back pain alone is estimated to total in excess of $100 billion annually. Yet the causes of these injuries are not well understood.Treating MSDs is a critical challenge. MSDs affect more than half of the U.S. adult population, and 75% of those over age 65, imposing an economic burden similar to or even greater than that of coronary heart disease and other major health problems. MSD pain is the main noncancer related reason for opioid use in the U.S. Despite the clear opportunity, federal investment in MSD translational research is disproportionately low.CDMI will continue to bring physicians, scientists, engineers, and industry partners together to boost collaboration and to train and retain the next generation of scientists and engineers.","url":"/centers/center-for-disruptive-musculoskeletal-innovations/","image":"/assets/images/twittercard.png","siteName":null,"type":"article"},"resilience":{"checks":[{"id":"pwa-https","label":"HTTPS (required for service workers)","status":"pass","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-disruptive-musculoskeletal-innovations/","why":"HTTPS is required for service workers and most install prompts."},{"id":"pwa-manifest","label":"Web app manifest declared","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-disruptive-musculoskeletal-innovations/","why":"A web app manifest is required for installability and controls how the app appears when launched."},{"id":"pwa-service-worker","label":"Service worker registered","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-disruptive-musculoskeletal-innovations/","why":"A service worker is what makes offline access, caching, and background sync possible."},{"id":"pwa-theme-color","label":"Theme color declared","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-disruptive-musculoskeletal-innovations/","why":"Theme color controls the browser chrome/status-bar color when the site is installed or bookmarked."},{"id":"pwa-apple-touch-icon","label":"Apple touch icon (iOS/bookmark icon)","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-disruptive-musculoskeletal-innovations/","why":"iOS uses this icon for home-screen bookmarks and \"Add to Home Screen\" — without it the icon falls back to a screenshot."},{"id":"manifest-parsed","label":"Manifest fetched and parsed successfully","status":"n/a","evidence":"No manifest declared","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-disruptive-musculoskeletal-innovations/","why":"A manifest that fails to parse cannot drive installability or launch behavior even if the link is present."