status":"n/a","evidence":"No manifest declared","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-advanced-semiconductor-chips-with-accelerated-performance/","why":"A maskable icon lets the OS safely crop/mask the app icon on different device shapes without clipping content."},{"id":"sw-active","label":"Service worker is active (not just registered)","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-advanced-semiconductor-chips-with-accelerated-performance/","why":"An active service worker (not just registered) is what actually intercepts requests and serves cached content."},{"id":"sw-controlling","label":"Service worker controls this page load","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-advanced-semiconductor-chips-with-accelerated-performance/","why":"A controlling service worker means THIS page load is being served/intercepted, not just a future one."},{"id":"installable","label":"Meets basic installability criteria","status":"fail","evidence":"no readable web app manifest; no service worker registered","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-advanced-semiconductor-chips-with-accelerated-performance/","why":"Determines whether the browser can realistically offer \"Add to Home Screen\" / install, based on manifest + service worker + HTTPS together."}],"manifest":null,"serviceWorker":{"registered":false,"active":false,"installing":false,"waiting":false,"controllingThisPage":false}}}}