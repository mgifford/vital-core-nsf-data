ds":{"engine":"standards","checks":[{"id":"schema-gov","label":"schema.org GovernmentOrganization markup","pass":false,"detail":""},{"id":"canonical","label":"Canonical URL declared","pass":true,"detail":""},{"id":"hreflang","label":"hreflang alternates declared","pass":false,"detail":""},{"id":"title","label":"Page has a <title>","pass":true,"detail":""},{"id":"description","label":"Meta description present","pass":true,"detail":""},{"id":"charset","label":"Character encoding declared","pass":true,"detail":""},{"id":"lang","label":"Document language (lang) set","pass":true,"detail":"en"},{"id":"viewport","label":"Responsive viewport (zoom not disabled)","pass":true,"detail":"width=device-width, initial-scale=1.0"},{"id":"open-graph","label":"Open Graph tags (5/6)","pass":true,"detail":""},{"id":"twitter-card","label":"Twitter card metadata","pass":true,"detail":""},{"id":"open-social","label":"Open social presence (Mastodon/Bluesky) linked","pass":false,"detail":""}],"passed":8,"total":11,"social":[],"og":{"title":"Center for Innovations in Structural Integrity Assurance (CISIA)","description":"Structural integrity and reliable lifespan prediction of infrastructure and mechanical components have relevance in every public and private sector, ranging from energy to aerospace to construction to chemical processing industries. CISIA serves as a trusted source of transformative insights, predictive capabilities, and materials innovations across broad industrial sectors, focusing on structural integrity assurance for small and large structures and mechanical components. CISIA conducts use-driven, fundamental, pre-competitive research to establish linkages between material properties and infrastructure performance in terms of its structural integrity. Establishing linkages between material properties, infrastructure performance, and structural integrity requires multi-disciplinary research collaborations; CISIA is well-positioned to elucidate and translate these links and their collective impact on reliability across all U.S. industrial sectors. The academic and industrial members of CISIA work in concert to produce a diverse workforce of engineers who are trained in state-of-the-art facilities to utilize modern methods of structural health monitoring and analysis. These engineers will join a highly qualified and productive workforce that significantly enhances the global competitiveness and resilience of U.S. industries.  ","url":"/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","image":"/assets/images/twittercard.png","siteName":null,"type":"article"},"resilience":{"checks":[{"id":"pwa-https","label":"HTTPS (required for service workers)","status":"pass","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"HTTPS is required for service workers and most install prompts."},{"id":"pwa-manifest","label":"Web app manifest declared","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"A web app manifest is required for installability and controls how the app appears when launched."},{"id":"pwa-service-worker","label":"Service worker registered","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"A service worker is what makes offline access, caching, and background sync possible."},{"id":"pwa-theme-color","label":"Theme color declared","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"Theme color controls the browser chrome/status-bar color when the site is installed or bookmarked."},{"id":"pwa-apple-touch-icon","label":"Apple touch icon (iOS/bookmark icon)","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"iOS uses this icon for home-screen bookmarks and \"Add to Home Screen\" — without it the icon falls back to a screenshot."},{"id":"manifest-parsed","label":"Manifest fetched and parsed successfully","status":"n/a","evidence":"No manifest declared","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"A manifest that fails to parse cannot drive installability or launch behavior even if the link is present."},{"id":"manifest-maskable-icon","label":"Manifest declares a maskable icon","status":"n/a","evidence":"No manifest declared","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"A maskable icon lets the OS safely crop/mask the app icon on different device shapes without clipping content."},{"id":"sw-active","label":"Service worker is active (not just registered)","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"An active service worker (not just registered) is what actually intercepts requests and serves cached content."},{"id":"sw-controlling","label":"Service worker controls this page load","status":"fail","evidence":"","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"A controlling service worker means THIS page load is being served/intercepted, not just a future one."},{"id":"installable","label":"Meets basic installability criteria","status":"fail","evidence":"no readable web app manifest; no service worker registered","exampleUrl":"https://iucrc.nsf.gov/centers/center-for-innovations-in-structural-integrity-assurance-cisia/","why":"Determines whether the browser can realistically offer \"Add to Home Screen\" / install, based on manifest + service worker + HTTPS together."}],"manifest":null,"serviceWorker":{"registered":false,"active